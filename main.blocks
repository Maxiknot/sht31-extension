<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="`}c_Amkps*N]u=jD)!Qe" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="/i=nwH~!qW9Aj*gKW6:#"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace SHT31 {" line1="    let sht31Address = 0x44" line2="" line3="    //% blockId=sht31_set_addr " line4="    //% block=&quot;set SHT31 I2C address %addr&quot;" line5="    //% weight=70" line6="    //% group=&quot;Setup&quot;" line7="    export function setAddress(addr: SHT31_ADDR): void {" line8="        sht31Address = addr" line9="    }" line10="" line11="    /**" line12="     * Read ambient temperature from SHT31 sensor in degrees Celsius (°C)" line13="     */" line14="    //% blockId=sht31_get_temperature " line15="    //% block=&quot;SHT31 temperature (°C)&quot;" line16="    //% weight=100" line17="    //% group=&quot;Readings&quot;" line18="    export function readTemperature(): number {" line19="        let cmd = pins.createBuffer(2)" line20="        cmd[0] = 0x2C" line21="        cmd[1] = 0x06" line22="        pins.i2cWriteBuffer(sht31Address, cmd)" line23="" line24="        basic.pause(20)" line25="" line26="        let data = pins.i2cReadBuffer(sht31Address, 6)" line27="        if (data.length &lt; 6) return 0" line28="" line29="        let rawTemp = (data[0] &lt;&lt; 8) | data[1]" line30="        let temp = -45 + (175 * rawTemp / 65535.0)" line31="" line32="        return Math.round(temp * 10) / 10" line33="    }" line34="" line35="    /**" line36="     * Read relative humidity from SHT31 sensor (%RH)" line37="     */" line38="    //% blockId=sht31_get_humidity " line39="    //% block=&quot;SHT31 humidity (%%RH)&quot;" line40="    //% weight=90" line41="    //% group=&quot;Readings&quot;" line42="    export function readHumidity(): number {" line43="        let cmd2 = pins.createBuffer(2)" line44="        cmd2[0] = 0x2C" line45="        cmd2[1] = 0x06" line46="        pins.i2cWriteBuffer(sht31Address, cmd2)" line47="" line48="        basic.pause(20)" line49="" line50="        let data2 = pins.i2cReadBuffer(sht31Address, 6)" line51="        if (data2.length &lt; 6) return 0" line52="" line53="        let rawHum = (data2[3] &lt;&lt; 8) | data2[4]" line54="        let hum = 100 * (rawHum / 65535.0)" line55="" line56="        return Math.round(hum * 10) / 10" line57="    }" line58="}" numlines="59"></mutation><next><block type="typescript_statement" id="T3AbDJpR2e0tMAq_p=5@"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum SHT31_ADDR {" line1="    //% block=&quot;0x44 (default)&quot;" line2="    ADDR_0x44 = 0x44," line3="    //% block=&quot;0x45 (ADDR connected to VCC)&quot;" line4="    ADDR_0x45 = 0x45" line5="}" numlines="6"></mutation></block></next></block></statement></block></xml>